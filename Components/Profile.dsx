<scroll style="background: groupedBackground">
<head>
  <!--
    Account management in the grouped Settings idiom: the avatar is the screen's one
    accent moment; the two fields live in an ACCOUNT card, sign-out in a SESSION card,
    and deletion — the dangerous thing — stands alone at the bottom, asking first in a
    sheet. Name and password go self-serve to GoTrue with the user's own bearer.
  -->
  <variable as="password">''</variable>
  <variable as="saved">false</variable>
  <variable as="problem">''</variable>
  <variable as="confirming">false</variable>
  <variable as="initial" computed="true">
    dsx.global.session &amp;&amp; dsx.global.session.name ? dsx.global.session.name.slice(0, 1).toUpperCase()
      : (dsx.global.session &amp;&amp; dsx.global.session.email ? dsx.global.session.email.slice(0, 1).toUpperCase() : '·')
  </variable>

  <action as="seed">
    if (!dsx.global.session) { return }
    account.values.name = dsx.global.session.name ? dsx.global.session.name : ''
  </action>

  <action as="save" inputs="name, password">
    saved = false
    problem = ''
    const body = { name: name }
    if (password) { body.password = password }
    const res = await fetch('/auth/profile', {
      method: 'POST',
      headers: { 'content-type': 'application/json', authorization: 'Bearer ' + dsx.global.session.token },
      body: JSON.stringify(body)
    })
    if (!res.ok) { problem = res.data &amp;&amp; res.data.message ? res.data.message : 'could not save'; return }
    dsx.global.session = { token: dsx.global.session.token, email: res.data.email, name: res.data.name }
    account.values.password = ''
    saved = true
  </action>

  <action as="signout">
    await fetch('/auth/logout', { method: 'POST' })
    dsx.global.session = null
    dsx.module.route.replace({ path: '/' })
  </action>

  <action as="destroy">
    problem = ''
    const res = await fetch('/auth/delete-account', {
      method: 'POST',
      headers: { authorization: 'Bearer ' + dsx.global.session.token }
    })
    confirming = false
    if (!res.ok) { problem = res.data &amp;&amp; res.data.message ? res.data.message : 'deletion failed'; return }
    dsx.global.session = null
    dsx.module.route.replace({ path: '/' })
  </action>

  <watch value="dsx.global.session" on:change="seed({ name: dsx.global.session ? dsx.global.session.name : '' })"/>
</head>
<stack style="gap: 1.75rem; padding: 0 1.5rem 2.5rem; max-width: 26rem; align-self: center; width: 100%; align-items: stretch" enter="rise" animDuration="350" on:appear="seed()">

  <text value="Profile" style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; padding-top: clamp(5rem, 10vh, 6.5rem)"/>

  <hstack style="gap: 1rem; align-items: center">
    <stack style="width: 3.5rem; height: 3.5rem; border-radius: 999px; background: accent; align-items: center; justify-content: center; flex-shrink: 0">
      <text bind="dsx.variable.initial" style="font-weight: 700; font-size: 1.375rem; color: background"/>
    </stack>
    <stack style="gap: 0.125rem; min-width: 0">
      <text value="{{ dsx.global.session &amp;&amp; dsx.global.session.name ? dsx.global.session.name : 'Unnamed' }}" style="font-weight: 600; font-size: 1.0625rem"/>
      <text value="{{ dsx.global.session ? dsx.global.session.email : '' }}" style="color: secondary; font-size: 0.9375rem"/>
    </stack>
  </hstack>

  <stack style="gap: 0.625rem; margin-top: 0.5rem; align-items: stretch">
    <text value="ACCOUNT" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="border-radius: 14px; background: secondaryGroupedBackground; padding: 1.125rem 1rem 0.875rem; align-items: stretch">
      <form as="account" on:submit="save({ name: account.values.name, password: account.values.password })">
        <field name="name" label="Display name" placeholder="{{ dsx.global.session &amp;&amp; dsx.global.session.name ? dsx.global.session.name : 'How you appear' }}"/>
        <field name="password" type="secure" label="New password" placeholder="Leave empty to keep"/>
      </form>
      <hstack style="align-items: center; gap: 0.75rem; margin-top: 0.75rem; min-height: 2.375rem; width: 100%">
        <text value="Saved." visible-if="dsx.variable.saved" transition="fade" style="color: secondary; font-size: 0.9375rem"/>
        <text bind="dsx.variable.problem" visible-if="dsx.variable.problem !== ''" transition="fade" style="color: destructive; font-size: 0.9375rem"/>
        <spacer/>
        <button label="Save" on:tap="save({ name: account.values.name, password: account.values.password })" style="background: label; color: background; font-weight: 600; border-radius: 10px; padding: 0.5rem 1.125rem"/>
      </hstack>
    </stack>
  </stack>

  <stack style="gap: 0.625rem; align-items: stretch">
    <text value="SESSION" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="border-radius: 14px; background: secondaryGroupedBackground; padding: 0.25rem 1rem; align-items: stretch">
      <row on:tap="signout()">
        <hstack style="align-items: center; justify-content: center; padding: 0.875rem 0; width: 100%">
          <text value="Sign out" style="font-weight: 500"/>
        </hstack>
      </row>
    </stack>
  </stack>

  <button label="Delete account&#8230;" role="destructive" on:tap="dsx.variable.confirming = true" style="font-size: 0.9375rem; font-weight: 500; align-self: center; margin-top: 0.75rem"/>

  <sheet present="dsx.variable.confirming" detents="content" title="Delete this account?"
         on:dismiss="dsx.variable.confirming = false">
    <stack style="gap: 1.25rem; padding: 1.5rem">
      <text value="This removes your account and every note in it. There is no undo." style="color: secondary"/>
      <stack style="gap: 0.625rem">
        <button label="Delete forever" variant="prominent" role="destructive" on:tap="destroy()"/>
        <button label="Keep my account" role="cancel" on:tap="dsx.variable.confirming = false"/>
      </stack>
    </stack>
  </sheet>
</stack>
</scroll>
