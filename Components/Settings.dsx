<scroll style="background: groupedBackground">
<head>
  <!--
    App settings: the dark-mode preference writes the app-wide store
    (global.settings.dark); every page root pins theme= from it, so flipping the
    switch re-themes the whole app (StackReference: the subtree color-scheme pin).
    The switch is the forms-dialect field toggle — the system's own settings-row
    idiom (label left, flagship switch right), no hand-built row. The about rows
    link the public pages. Deliberately small — a starter's settings screen is a
    shape to extend.
  -->
  <action as="seed">
    prefs.values.dark = dsx.global.settings &amp;&amp; dsx.global.settings.dark ? true : false
  </action>
</head>
<stack style="gap: 1.5rem; padding: 2rem 1.5rem; max-width: 26rem; align-self: center; width: 100%" enter="rise" animDuration="350" on:appear="seed()">

  <text value="Settings" style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; padding-top: 2rem"/>

  <stack style="gap: 0.75rem">
    <text value="APPEARANCE" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="border-radius: 14px; background: secondaryGroupedBackground; padding: 0.25rem 1rem">
      <field form="prefs" name="dark" type="toggle" label="Dark appearance"
             on:change="dsx.global.settings = { dark: prefs.values.dark === true }"/>
    </stack>
  </stack>

  <stack style="gap: 0.75rem">
    <text value="ABOUT" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="border-radius: 14px; background: secondaryGroupedBackground; padding: 0 1rem">
      <row href="/about">
        <hstack style="align-items: center; gap: 0.75rem; padding: 0.875rem 0; border-bottom: 1px solid separator">
          <text value="How this app is built"/>
          <spacer/>
          <image icon="chevron.right" style="color: tertiary; width: 1rem; height: 1rem"/>
        </hstack>
      </row>
      <row href="/">
        <hstack style="align-items: center; gap: 0.75rem; padding: 0.875rem 0">
          <text value="The landing page"/>
          <spacer/>
          <image icon="chevron.right" style="color: tertiary; width: 1rem; height: 1rem"/>
        </hstack>
      </row>
    </stack>
  </stack>

  <text value="Field Notes 0.1.0 — built with Despia. One codebase: native iOS, native Android, and this web app. Copy it, rename it, ship yours." style="color: tertiary; font-size: 0.8125rem; margin-top: 0.5rem"/>
</stack>
</scroll>
