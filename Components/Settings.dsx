<stack style="gap: 1.25rem; padding: 2rem; max-width: 26rem; align-self: center; width: 100%" enter="rise" animDuration="350">
  <head>
    <!--
      App settings: the dark-mode preference writes the app-wide store
      (global.settings.dark, the system theme plane), and the about rows link the
      public pages. Deliberately small — a starter's settings screen is a shape to
      extend, not a product.
    -->
  </head>

  <text value="Settings" style="font-size: 1.75rem; font-weight: 700"/>

  <hstack style="align-items: center; gap: 0.75rem">
    <text value="Dark appearance"/>
    <spacer/>
    <toggle bind="global.settings.dark"/>
  </hstack>

  <stack style="gap: 0.5rem; margin-top: 1rem">
    <text value="About" style="font-weight: 600; opacity: 0.6; font-size: 0.875rem"/>
    <row href="/about"><text value="How this app is built"/></row>
    <row href="/"><text value="The landing page"/></row>
  </stack>

  <text value="Field Notes is the Despia starter: one codebase, native iOS, native Android, PWA and this web app. Copy it, rename it, ship yours." style="opacity: 0.5; font-size: 0.875rem; margin-top: 1rem"/>
</stack>
