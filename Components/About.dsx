<scroll theme="{{ dsx.global.settings &amp;&amp; dsx.global.settings.dark ? 'dark' : '' }}" style="background: background; color: label">
  <head>
    <!--
      The colophon page: what renders these documents, in the same editorial grammar
      as the landing. Public, SSR-visible, linked from the hero and from Settings.
    -->
    <variable as="surfaces">
      return [
        { id: "ios", name: "Native iOS", how: "The Swift kernel renders these documents as SwiftUI." },
        { id: "android", name: "Native Android", how: "The Kotlin kernel renders them as Jetpack Compose." },
        { id: "pwa", name: "The web app", how: "dsx build compiles the same documents for the browser, installable as a PWA." },
        { id: "ssr", name: "This site", how: "@despia/server renders every route on the server first, so pages arrive as HTML." }
      ]
    </variable>
  </head>

  <stack style="gap: 0; max-width: 46rem; align-self: center; width: 100%; padding: 0 1.5rem">
    <hstack style="align-items: center; padding: 1.375rem 0">
      <text value="Field Notes" href="/" style="font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em"/>
    </hstack>

    <stack style="gap: 1rem; padding: clamp(4rem, 9vh, 6.5rem) 0 0">
      <text value="How it&#8217;s built." style="font-size: 2rem; font-weight: 800; letter-spacing: -0.025em"/>
      <text value="Every surface below renders the same handful of .dsx documents. None of them is a port." style="color: secondary; line-height: 1.55; max-width: 40ch"/>
    </stack>

    <stack style="gap: 2.5rem; padding: 3.5rem 0 5rem">
      <list bind="dsx.variable.surfaces" key="id" spacing="0">
        <row>
          <stack style="gap: 0.375rem; padding: 0 0 2.5rem">
            <text bind="item.name" style="font-weight: 600; font-size: 1.0625rem"/>
            <text bind="item.how" style="color: secondary; font-size: 0.9375rem; line-height: 1.5; max-width: 48ch"/>
          </stack>
        </row>
      </list>
    </stack>

    <hstack style="gap: 1rem; padding: 1.75rem 0 2.25rem; align-items: center; border-top: 1px solid separator">
      <text value="Built with Despia." style="color: tertiary; font-size: 0.8125rem"/>
      <spacer/>
      <text value="Home" href="/" style="color: secondary; font-size: 0.8125rem; font-weight: 500; padding: 0.25rem"/>
    </hstack>
  </stack>
</scroll>
