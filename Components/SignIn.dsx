<stack style="gap: 1rem; padding: 3rem 2rem; max-width: 26rem; align-self: center" enter="rise" animDuration="400">
  <head>
    <!--
      Sign in / sign up with the plain form grammar — fields, validation and submit are
      document words, so this screen is native on iOS and Android and a real form on the
      web. The page talks only to the app's own /auth routes: it never sees the identity
      provider or any API key. The refresh token rides an HttpOnly cookie the browser
      keeps; the access token lives in global.session and travels as a bearer.
    -->
    <variable as="mode">'signin'</variable>
    <variable as="busy">false</variable>
    <variable as="problem">''</variable>

    <action as="authenticate" inputs="email, password, name">
      busy = true
      problem = ''
      const path = mode === 'signin' ? '/auth/login' : '/auth/signup'
      try {
        const res = await fetch(path, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email, password: password, name: name })
        })
        const body = await res.json()
        if (!res.ok) { throw { message: body.message ? body.message : 'sign-in failed' } }
        dsx.global.session = { token: body.token, email: body.email, name: body.name }
        dsx.module.route.replace({ path: '/notes' })
      } catch (e) {
        problem = e.message ? e.message : 'something went wrong — try again'
      }
      busy = false
    </action>
  </head>

  <text value="{{ dsx.variable.mode === 'signin' ? 'Welcome back' : 'Create your account' }}" style="font-size: 1.75rem; font-weight: 700"/>
  <text value="{{ dsx.variable.mode === 'signin' ? 'Sign in to your field notes.' : 'A real account on the real backend.' }}" style="opacity: 0.65"/>

  <form as="auth" submit="{{ dsx.variable.mode === 'signin' ? 'Sign in' : 'Sign up' }}"
        on:submit="authenticate({ email: auth.values.email, password: auth.values.password, name: auth.values.name })">
    <field name="name" label="Name" placeholder="What should we call you?"
           visible-if="dsx.variable.mode === 'signup'" transition="rise"/>
    <field name="email" type="email" label="Email" validate="required,email"/>
    <field name="password" type="secure" label="Password" validate="required,minLength:8"/>
  </form>

  <button label="{{ dsx.variable.mode === 'signin' ? 'New here? Create an account' : 'Have an account? Sign in' }}"
          on:tap="dsx.variable.mode = dsx.variable.mode === 'signin' ? 'signup' : 'signin'; dsx.variable.problem = ''"/>

  <text bind="dsx.variable.problem" visible-if="dsx.variable.problem !== ''" transition="rise" style="color: #c0392b"/>
  <text value="One moment…" visible-if="dsx.variable.busy" transition="fade" style="opacity: 0.6"/>
</stack>
