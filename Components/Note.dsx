<stack style="gap: 1rem; padding: 2rem; max-width: 40rem; align-self: center" enter="rise" animDuration="350">
  <head>
    <!--
      The gated detail screen: fetch one row by the route param, edit in place, save
      through the declared PATCH route. The same guard shape as Notes.dsx.
    -->
    <variable as="note">return null</variable>
    <variable as="saved">false</variable>

    <action as="boot">
      if (!dsx.global.session) {
        const back = await fetch('/auth/refresh', { method: 'POST' })
        if (back.ok) { const me = await back.json(); dsx.global.session = { token: me.token, email: me.email } }
      }
      if (!dsx.global.session) { dsx.module.route.replace({ path: '/signin' }); return }
      const res = await fetch('/api/notes/' + dsx.params.id, { headers: { authorization: 'Bearer ' + dsx.global.session.token } })
      if (res.status === 401) { dsx.global.session = null; dsx.module.route.replace({ path: '/signin' }); return }
      if (res.status === 404) { dsx.module.route.replace({ path: '/notes' }); return }
      note = await res.json()
    </action>

    <action as="save">
      saved = false
      await fetch('/api/notes/' + dsx.params.id, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json', authorization: 'Bearer ' + dsx.global.session.token },
        body: JSON.stringify({ values: { title: note.title, body: note.body } })
      })
      saved = true
    </action>

    <watch value="dsx.route.path" on:change="boot()"/>
  </head>

  <button label="&#8592; All notes" href="/notes" style="align-self: flex-start"/>

  <stack visible-if="dsx.variable.note" transition="fade" style="gap: 0.75rem">
    <field name="title" bind="dsx.variable.note.title" label="Title"/>
    <field name="body" bind="dsx.variable.note.body" label="Note" type="text" multiline="true"/>
    <hstack style="gap: 0.75rem; align-items: center">
      <button label="Save" role="primary" on:tap="save()"/>
      <text value="Saved." visible-if="dsx.variable.saved" transition="fade" style="opacity: 0.6"/>
    </hstack>
  </stack>
</stack>
