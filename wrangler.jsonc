// The example's deploy manifest: `npm run build` first, then `npx wrangler deploy`.
// The worker runs first: it owns /auth and /api and reaches the static tree through the
// ASSETS binding. Postgres arrives as the HYPERDRIVE binding (the bootloader maps its
// connectionString to DSX_DATABASE_URL) — create it once:
//   npx wrangler hyperdrive create despia-example --connection-string="<SUPABASE_POSTGRES_URL>"
// then paste the returned id below. Local dev mirrors production:
//   WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="<SUPABASE_POSTGRES_URL>" npx wrangler dev
// Secrets (never in this file): npx wrangler secret put SUPABASE_SERVICE_KEY
{
  "name": "despia-example",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
  ],
  "vars": {
    "SUPABASE_URL": "https://hforkizbesezccnbeqjh.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhmb3JraXpiZXNlemNjbmJlcWpoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTczNTUwMDYsImV4cCI6MjA3MjkzMTAwNn0.DGbKC-QQKnuDP4wVQx_2mC4on2WcyBESSzUpbFzTiaw",
    "DSX_JWT_JWKS_URL": "https://hforkizbesezccnbeqjh.supabase.co/auth/v1/.well-known/jwks.json",
    "DSX_JWT_ISSUER": "https://hforkizbesezccnbeqjh.supabase.co/auth/v1"
  },
  "routes": [
    { "pattern": "exampleapp.despia.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
